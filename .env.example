# RPC access is used only by refresh and conformance; it is never used by the static browser app.
ETHEREUM_RPC_URL=

# Optional log-only RPC. This permits independent providers for archive state
# and wide historical eth_getLogs queries.
AMPL_LOG_RPC_URL=

# The pinned release block is used only by refresh and conformance.
RELEASE_BLOCK=
RELEASE_BLOCK_HASH=

# Optional provider-specific eth_getLogs block range.
AMPL_LOG_RANGE_BLOCKS=

# Optional fail-closed guard for providers that cap a log response without
# pagination. A response at this count is retried over smaller block ranges.
AMPL_LOG_RESPONSE_LIMIT=

# Optional delay between requests to each no-key public RPC. A value such as
# 250 serializes calls at no more than four requests per second and retries
# explicit HTTP 429/rate-limit responses with bounded backoff.
RPC_REQUEST_INTERVAL_MS=

# Pin the generation timestamp of a release refresh to the value in
# release/refresh-config.json so regenerated files reproduce the committed bytes.
REFRESH_GENERATED_AT=

# Extended history collection and optional background refresh.
OBSERVATORY_HISTORY_DAYS=90
OBSERVATORY_SAMPLE_INTERVAL_DAYS=7
OBSERVATORY_REFRESH_MINUTES=60
# Empty means public/data. Use a local directory or a mounted volume.
OBSERVATORY_DATA_DIRECTORY=
