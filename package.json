{
  "name": "observatory-for-spot",
  "version": "1.0.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:source": "tsx scripts/check-source-boundary.ts",
    "check:licenses": "tsx scripts/license-notices.ts --check",
    "check:privacy": "tsx scripts/privacy-scan.ts",
    "licenses:generate": "tsx scripts/license-notices.ts",
    "refresh": "tsx scripts/refresh.ts",
    "conformance": "tsx scripts/conformance.ts",
    "verify:data": "tsx scripts/verify-release-data.ts",
    "acceptance": "tsx scripts/acceptance.ts",
    "package:release": "tsx scripts/package-release.ts",
    "export-static": "npm run build",
    "serve-static": "node scripts/serve-static.mjs",
    "refresh:observatory": "node --import tsx scripts/refresh-observatory.ts",
    "refresh:watch": "node --import tsx scripts/watch-observatory.ts"
  },
  "dependencies": {
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "viem": "^2.56.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
